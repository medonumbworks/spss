<!-- CSPRNG Predictor sample: the same draws as the last rows of draws.csv,
     written in the three supported XML forms with different date styles. -->
<draws>
  <!-- Form one: numbers as child elements, date attribute -->
  <draw date="2026-10-11"><n>1</n><n>3</n><n>7</n><n>8</n><n>9</n><n>10</n><n>11</n><n>12</n><n>15</n><n>18</n><n>20</n></draw>
  <!-- Form two: numbers attribute -->
  <draw date="2026-10-12" numbers="2 3 4 5 8 11 12 14 15 19 22"/>
  <!-- Form three: date and numbers child elements -->
  <draw>
    <date>13.10.2026</date>
    <numbers>1,4,6,7,8,9,12,13,16,19,21</numbers>
  </draw>
  <draw date="14.10.2026"><n>1</n><n>2</n><n>4</n><n>5</n><n>8</n><n>9</n><n>10</n><n>13</n><n>17</n><n>19</n><n>20</n></draw>
  <draw date="2026/10/15" numbers="2 3 6 9 12 15 16 17 19 21 22"/>
  <draw>
    <date>2026-10-16</date>
    <numbers>1,3,7,8,9,13,14,16,17,18,20</numbers>
  </draw>
</draws>
