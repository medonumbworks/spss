<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 10+ in dark mode. The night qualifier outranks the API level when resources
      are resolved, so without this file values-night/styles.xml would win on Android 10+;
      this keeps the DayNight theme of values-v29/styles.xml there.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:actionBarTheme">@android:style/ThemeOverlay.Material.Dark.ActionBar</item>
        <item name="android:actionBarPopupTheme">@android:style/ThemeOverlay.Material.Dark</item>
    </style>
</resources>
