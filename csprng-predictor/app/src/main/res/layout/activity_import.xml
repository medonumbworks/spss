<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Shown while the file is read / parsed / imported. -->
    <LinearLayout
        android:id="@+id/importLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/importLoadingText"
            style="@style/BodyText"
            android:layout_width="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/reading_file" />
    </LinearLayout>

    <!-- Summary, options and preview; the header (import_header.xml) scrolls with the list. -->
    <ListView
        android:id="@+id/importList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:paddingTop="16dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />

    <View style="@style/Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnImportCancel"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_marginEnd="4dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btnImportConfirm"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/import_button" />
    </LinearLayout>
</LinearLayout>
