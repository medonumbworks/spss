<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 10+: follow the system light / dark setting. Same colours as values/styles.xml;
      the action bar keeps white text on the blue primary colour in both modes.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:actionBarTheme">@android:style/ThemeOverlay.Material.Dark.ActionBar</item>
        <item name="android:actionBarPopupTheme">@android:style/ThemeOverlay.Material.Light</item>
    </style>
</resources>
