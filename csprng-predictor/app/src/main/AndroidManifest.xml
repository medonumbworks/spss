<?xml version="1.0" encoding="utf-8"?>
<!--
  package= is kept for the SDK-less aapt2 build (scripts/build-apk.sh); the Gradle build
  takes the namespace from app/build.gradle. No permissions: files are read and written
  through the Storage Access Framework only. Rotation is handled by the activities
  themselves (no android:configChanges).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.medonumbworks.csprngpredictor"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddDrawActivity"
            android:exported="false"
            android:label="@string/title_add_draw"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ImportActivity"
            android:exported="false"
            android:label="@string/title_import" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false"
            android:label="@string/title_stats" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
